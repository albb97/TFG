# n8n webhook endpoints (fill with your own n8n instance URLs)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/chat
VITE_N8N_DEVICES_URL=https://your-n8n-instance/webhook/catalogo
VITE_N8N_UPLOAD_URL=https://your-n8n-instance/webhook/upload
VITE_N8N_OPTIMIZE_URL=https://your-n8n-instance/webhook/optimize
VITE_N8N_FEEDBACK_URL=https://your-n8n-instance/webhook/feedback

# Demo-only admin credentials (client-side check, NOT secure for production)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=change-me

VITE_APP_NAME=AGUS
VITE_APP_VERSION=1.0.0
